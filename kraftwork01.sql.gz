--

CREATE TABLE IF NOT EXISTS `torcamento` (
  `chave_orcamento` int(11) NOT NULL,
  `chave_perfil` int(11) NOT NULL,
  `chave_cliente` int(11) NOT NULL,
  `chave_recibo` int(11) NOT NULL,
  `cod_orcamento` varchar(256) NOT NULL,
  `valor_orcamento` decimal(12,2) NOT NULL,
  `dtc_orcamento` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `dte_orcamento` datetime NOT NULL,
  `dta_orcamento` datetime NOT NULL,
  `dtr_orcamento` datetime NOT NULL,
  `dtrecibo_orcamento` datetime NOT NULL,
  `dtrecusado_orcamento` datetime NOT NULL,
  `dtu_orcamento` datetime NOT NULL,
  `urlpdf_orcamento` varchar(256) NOT NULL,
  `urlaprova_orcamento` varchar(256) NOT NULL,
  `situacao_orcamento` varchar(20) NOT NULL DEFAULT 'CRIADO',
  `caixa_orcamento` int(11) NOT NULL DEFAULT '1'
) ENGINE=MyISAM AUTO_INCREMENT=11 DEFAULT CHARSET=latin1;

